<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS Hardened Runtime Entitlements for WrongStack Desktop.

  These are the minimum entitlements required for an Electron application to
  pass Apple notarization. The values must be declared both here AND in a
  provisioning profile when distributing through the Mac App Store.

  For developer-ID signed distribution, only this file is needed; the signing
  identity itself carries the entitlement grant.

  See:
    https://developer.apple.com/documentation/security/hardened-runtime
    https://www.electronjs.org/docs/latest/tutorial/code-signing
-->
<plist version="1.0">
  <dict>
    <!-- Allow V8 JIT compilation — Electron needs executable/writable memory
         for JavaScript performance. Without this, the renderer process crashes
         on startup because V8 cannot allocate JIT code pages. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Allow loading native Node.js addons and Electron's own frameworks from
         paths outside /usr/lib (the app bundle's Frameworks/ and Resources/). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>

    <!-- Network client access — required for HTTP, WebSocket, and SSE
         connections to local WebUI server instances. -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Read/write user-selected files — enables the File > Open Folder dialog
         to select project directories. Without this, openDirectory dialogs
         return empty filePaths on hardened runtime. -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Allow the embedded WebUI to use audio/video (future: voice mode,
         screen sharing). These are declared now so notarization includes them
         and users are prompted on first access rather than seeing a crash. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.microphone</key>
    <true/>
  </dict>
</plist>
