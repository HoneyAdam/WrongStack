<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS Info.plist template for WrongStack Desktop.

  This file is merged into the app bundle's Contents/Info.plist during
  packaging. The Electron binary provides its own plist; these keys
  supplement or override it per Apple's bundle conventions.

  Usage descriptions (NS*UsageDescription) are REQUIRED for notarization
  when the app links against frameworks that imply access. Declare them
  even when the feature is not yet implemented — missing descriptions
  cause immediate notarization rejection.

  See:
    https://developer.apple.com/documentation/bundleresources/information_property_list
    https://www.electronjs.org/docs/latest/tutorial/application-distribution
-->
<plist version="1.0">
  <dict>
    <!-- High-resolution (Retina) display support -->
    <key>NSHighResolutionCapable</key>
    <true/>

    <!-- Optimize GPU switching on dual-GPU MacBooks (save battery) -->
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>

    <!-- App Store category: Developer Tools -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.developer-tools</string>

    <!-- -----------------------------------------------
         Privacy Usage Descriptions
         These are shown to the user the first time the
         corresponding API is called. Required for
         notarization when the frameworks are linked.
         ----------------------------------------------- -->

    <!-- Camera access (future: voice/video mode, screen sharing) -->
    <key>NSCameraUsageDescription</key>
    <string>WrongStack Desktop uses the camera for video calls and screen sharing during collaboration features.</string>

    <!-- Microphone access (future: voice commands, voice mode) -->
    <key>NSMicrophoneUsageDescription</key>
    <string>WrongStack Desktop uses the microphone for voice commands and voice chat during collaboration features.</string>

    <!-- Bluetooth (future: peripheral pairing) -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>WrongStack Desktop uses Bluetooth to connect to nearby devices for authentication and collaboration.</string>

    <!-- --------------------------------------------------
         File System & Security
         -------------------------------------------------- -->
    <!-- Electron 43+ supports Apple Events for automation -->
    <key>NSAppleEventsUsageDescription</key>
    <string>WrongStack Desktop uses Apple Events to integrate with your development tools and editors.</string>

    <!-- Open documents / file types (future) -->
    <key>CFBundleDocumentTypes</key>
    <array>
      <dict>
        <key>CFBundleTypeName</key>
        <string>WrongStack Session</string>
        <key>CFBundleTypeRole</key>
        <string>Editor</string>
        <key>LSHandlerRank</key>
        <string>Owner</string>
        <key>LSItemContentTypes</key>
        <array>
          <string>public.folder</string>
        </array>
      </dict>
    </array>

    <!-- --------------------------------------------------
         Electron-specific
         -------------------------------------------------- -->
    <!-- Prevent the app from showing in the "Recent Items" list
         during development. Set to true for release builds. -->
    <key>LSMultipleInstancesProhibited</key>
    <true/>

    <!-- Quit when the last window closes (standard macOS behavior
         for document-based apps; Electron apps typically use
         app.on('window-all-closed') instead, so this is redundant
         but harmless). -->
    <key>NSQuitAlwaysKeepsWindows</key>
    <false/>
  </dict>
</plist>
